#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "rover_rb3_description"
    doc = """Generated from Composed Stage of root layer /tmp/tmpeo_zqyvv/rover_rb3_description.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_rover_rb3_qj84k70j/usdex_rover_rb3/rover_rb3_description.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_rover_rb3_qj84k70j/temp_rover_rb3/rover_rb3.usd


Generated from Composed Stage of root layer /home/johanna/Workspaces/msc_project_ws/RB3_ws/base/robot_ws/src/robot_description/urdf/rover_rb3_1/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "rover_rb3_description" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_11"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_11.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_11.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_11.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_11.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

